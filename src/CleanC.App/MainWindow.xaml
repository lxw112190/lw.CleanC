<Window x:Class="CleanC.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CleanC.App"
    Title="CleanC · C 盘空间管家" Width="1320" Height="880" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen"
    Background="#F5F8F8" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Closing="Window_Closing">
  <Grid x:Name="LayoutRoot" Background="#F5F8F8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#112F35">
      <DockPanel Margin="20,32,18,24">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="C /" Foreground="#6DE4CB" FontSize="34" FontWeight="Bold"/>
          <TextBlock Text="CleanC" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,5,0,4"/>
          <TextBlock Text="给 C 盘，留一点余地。" Foreground="#9BB4B8" FontSize="12"/>
          <Border Height="1" Background="#2D484E" Margin="0,26,0,22"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="#21444A" CornerRadius="8" Padding="12"><StackPanel>
            <TextBlock Text="●  本地运行" Foreground="#6DE4CB" FontWeight="SemiBold"/>
            <TextBlock Text="数据留在你的电脑上" Foreground="#ADC3C7" FontSize="11" Margin="0,6,0,0"/>
          </StackPanel></Border>
          <TextBlock Text="个人空间工具 / v0.3.0" Foreground="#829FA5" FontSize="11" Margin="4,16,0,0"/>
        </StackPanel>
        <StackPanel>
          <Button Content="01   空间概览" Tag="0" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,10" Background="#21444A" Foreground="White" BorderBrush="#34545B"/>
          <Button Content="02   分类清理" Tag="1" Click="Navigate" Margin="0,0,0,10" Background="#21444A" Foreground="White" BorderBrush="#34545B"/>
          <Button Content="03   空间分析" Tag="2" Click="Navigate" Margin="0,0,0,10" Background="#21444A" Foreground="White" BorderBrush="#34545B"/>
          <Button Content="04   规则与排除" Tag="3" Click="Navigate" Margin="0,0,0,10" Background="#21444A" Foreground="White" BorderBrush="#34545B"/>
          <Button Content="05   清理记录" Tag="4" Click="Navigate" Background="#21444A" Foreground="White" BorderBrush="#34545B"/>
          <Button Content="06   重复文件" Tag="5" Click="Navigate" Margin="0,10,0,0" Background="#21444A" Foreground="White" BorderBrush="#34545B"/>
          <Button Content="07   专项清理" Tag="6" Click="Navigate" Margin="0,10,0,0" Background="#21444A" Foreground="White" BorderBrush="#34545B"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22"><StackPanel>
        <TextBlock x:Name="PageTitle" Text="空间概览" FontSize="26" FontWeight="Bold"/>
        <TextBlock x:Name="PageSubtitle" Text="看清占用，按需整理。" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
      </StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="PauseButton" Content="暂停扫描" IsEnabled="False" Click="Pause_Click"/>
        <Button x:Name="CancelButton" Content="停止当前任务" IsEnabled="False" Click="Cancel_Click"/>
      </StackPanel></Grid>
      <TabControl x:Name="Pages" Grid.Row="1" BorderThickness="0" Background="Transparent">
        <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Background="#E5F3EF" CornerRadius="14" Padding="28" Margin="0,0,0,20"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="SYSTEM DRIVE / C:" Foreground="#42766E" FontSize="11" FontWeight="Bold"/>
              <TextBlock Text="让每一份空间，都有去处。" FontSize="25" FontWeight="SemiBold" Margin="0,14,0,12"/>
              <TextBlock x:Name="DriveDetail" Text="正在读取磁盘信息…" Foreground="#42766E"/>
              <ProgressBar x:Name="DriveBar" Height="8" Margin="0,20,30,0" Background="#C6DFD8" Foreground="#087F75" BorderThickness="0"/>
            </StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock Text="可用空间" Foreground="#42766E"/>
              <TextBlock x:Name="FreeText" Text="—" FontSize="40" FontWeight="Bold" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid></Border>
          <UniformGrid Columns="3" Margin="0,0,0,20">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="缓存预览 · 文件大小" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CacheTotal" Text="未扫描" FontSize="25" FontWeight="Bold" Margin="0,12,0,7"/><TextBlock Text="先扫描，再决定清理范围" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="可识别的清理规则" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RuleCount" Text="—" FontSize="25" FontWeight="Bold" Margin="0,12,0,7"/><TextBlock Text="日常 / 软件 / 开发缓存" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="空间分析 · 文件总量" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AnalysisTotal" Text="未分析" FontSize="25" FontWeight="Bold" Margin="0,12,0,7"/><TextBlock Text="支持查看目录和大文件排行" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
          </UniformGrid>
          <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel>
            <TextBlock Text="从这里开始" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="清理已知缓存，或者找出那些意料之外的大目录。" Foreground="{StaticResource Muted}" Margin="0,9,0,20"/>
            <WrapPanel><Button Content="扫描日常与开发缓存" Style="{StaticResource Primary}" Click="Scan_Click"/><Button Content="分析整个 C 盘" Click="AnalyzeC_Click"/><Button Content="选择目录分析" Click="ChooseFolder_Click"/><Button Content="uv 官方缓存清理…" Click="UvClean_Click"/></WrapPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="系统空间，交给系统工具" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Windows 更新、旧系统文件等项目，可在 Windows 存储设置中检查。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,18"/>
            <WrapPanel><Button Content="打开 Windows 存储设置" Click="Storage_Click"/><Button Content="打开系统磁盘清理" Click="DiskCleanup_Click"/></WrapPanel>
          </StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14">
            <Button Content="扫描缓存" Style="{StaticResource Primary}" Click="Scan_Click"/>
            <Button Content="勾选普通项目" Click="SelectAll_Click"/><Button Content="清空勾选" Click="SelectNone_Click"/>
            <TextBlock x:Name="SelectionTotal" Text="尚未扫描" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </DockPanel>
          <DataGrid x:Name="RulesGrid" Grid.Row="1" SelectionChanged="Rule_SelectionChanged" IsReadOnly="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="44"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="清理项目" Binding="{Binding Name}" Width="180" IsReadOnly="True"/>
              <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="85" IsReadOnly="True"/>
              <DataGridTextColumn Header="方式" Binding="{Binding ModeText}" Width="85" IsReadOnly="True"/>
              <DataGridTextColumn Header="文件大小" Binding="{Binding SizeText}" Width="100" IsReadOnly="True"/>
              <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="70" IsReadOnly="True"/>
              <DataGridTextColumn Header="扫描状态" Binding="{Binding Status}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Margin="0,14,0,10">
            <TextBlock x:Name="ImpactText" Text="选择一行查看影响与文件预览。" TextWrapping="Wrap" FontWeight="SemiBold"/>
              <TextBlock x:Name="PreviewNote" Text="每项默认不勾选；预览保留最近几天的文件。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <DockPanel Margin="0,10,0,0">
              <TextBlock Text="搜索文件" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
              <Button Content="下一页" DockPanel.Dock="Right" Padding="10,5" Click="PreviewNext_Click"/>
              <Button Content="上一页" DockPanel.Dock="Right" Padding="10,5" Click="PreviewPrevious_Click"/>
              <TextBlock x:Name="PreviewPageText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0"/>
              <TextBox x:Name="PreviewSearch" Padding="8,5" BorderBrush="#D9E3E5" TextChanged="PreviewSearch_Changed" ToolTip="搜索所选清理项中的全部候选路径。搜索只影响显示，清理仍处理勾选项目的全部结果。"/>
            </DockPanel>
          </StackPanel>
          <DataGrid x:Name="PreviewGrid" Grid.Row="3" IsReadOnly="True" MouseDoubleClick="Preview_Open">
            <DataGrid.Columns><DataGridTextColumn Header="文件路径 · 双击定位" Binding="{Binding Path}" Width="*"/>
              <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/><DataGridTextColumn Header="最后修改" Binding="{Binding ModifiedText}" Width="145"/></DataGrid.Columns>
          </DataGrid>
          <DockPanel Grid.Row="4" Margin="0,14,0,0"><Button Content="排除此文件" Click="ExcludeFile_Click"/>
            <Button x:Name="CleanButton" Content="清理勾选项目…" Style="{StaticResource Primary}" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Clean_Click" IsEnabled="False"/>
            <TextBlock Text="永久删除缓存；操作前会再次确认范围。" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11"/>
          </DockPanel>
        </Grid></TabItem>
        <TabItem><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="155"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12"><Button Content="分析 C 盘" Style="{StaticResource Primary}" Click="AnalyzeC_Click"/><Button Content="选择目录" Click="ChooseFolder_Click"/><Button Content="上一级" Click="Parent_Click"/><Button Content="导出分析 CSV" Click="Export_Click"/></WrapPanel>
          <TextBlock x:Name="AnalysisDetail" Grid.Row="1" Text="尚未分析。目录可双击继续深入，大文件双击定位。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
          <local:UsageMap x:Name="DirectoryMap" Grid.Row="2" Margin="0,0,0,14" ToolTip="矩形面积代表目录逻辑大小，双击继续深入。"/>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="目录占用排行" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <DataGrid x:Name="FoldersGrid" Grid.Row="1" IsReadOnly="True" MouseDoubleClick="Folder_DoubleClick"><DataGrid.Columns>
                <DataGridTextColumn Header="目录" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="95"/>
                <DataGridTemplateColumn Header="占比" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ProgressBar Value="{Binding Percent}" Height="6" Width="65" Foreground="#0A9686" Background="#E3EEEC" BorderThickness="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns></DataGrid>
            </Grid>
            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <ComboBox x:Name="AnalysisView" SelectedIndex="0" Margin="0,0,0,12" Padding="8,4" SelectionChanged="AnalysisView_Changed"><ComboBoxItem Content="最大的 200 个文件"/><ComboBoxItem Content="文件类型占用"/></ComboBox>
              <DataGrid x:Name="LargeFilesGrid" Grid.Row="1" IsReadOnly="True" MouseDoubleClick="LargeFile_Open"><DataGrid.Columns><DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/></DataGrid.Columns></DataGrid>
            </Grid>
          </Grid>
        </Grid></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
            <TextBlock Text="你的清理规则" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="JSON 定义路径、分类、保留天数、相关进程及清理影响。编辑保存后，重新载入并扫描生效。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,14"/>
            <TextBox x:Name="RulesPathText" IsReadOnly="True" BorderThickness="0" Background="#F2F6F6" Padding="12" Margin="0,0,0,14"/>
            <WrapPanel><Button Content="编辑 JSON 规则" Click="EditRules_Click"/><Button Content="重新载入规则" Click="ReloadRules_Click"/><Button Content="打开数据目录" Click="OpenData_Click"/></WrapPanel>
            <TextBlock Text="自定义路径限 LocalAppData 下具体应用的 Cache 等缓存目录；系统目录和个人文档不能加入清理规则。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="排除列表" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="排除项同时作用于缓存扫描、清理与空间分析。添加或删除后，请重新扫描。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,14"/>
            <WrapPanel Margin="0,0,0,14"><Button Content="添加排除目录" Click="AddExclusion_Click"/><Button Content="移除选中排除项" Click="RemoveExclusion_Click"/></WrapPanel>
            <ListBox x:Name="ExclusionsList" MinHeight="100" MaxHeight="240" BorderBrush="#D9E3E5" Padding="8"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,14"><Button Content="刷新记录" Click="RefreshHistory_Click"/><Button Content="打开记录目录" Click="OpenHistory_Click"/></WrapPanel>
          <TextBlock Grid.Row="1" Text="逐文件记录清理意图与结果。文件大小是逻辑大小，可用空间变化还会受到其他程序影响。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
          <DataGrid x:Name="HistoryGrid" Grid.Row="2" IsReadOnly="True" MouseDoubleClick="History_Open"><DataGrid.Columns>
            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="160"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="160"/>
            <DataGridTextColumn Header="已删 / 跳过" Binding="{Binding Counts}" Width="100"/><DataGridTextColumn Header="文件大小" Binding="{Binding Bytes}" Width="110"/><DataGridTextColumn Header="可用空间变化" Binding="{Binding Delta}" Width="*"/>
          </DataGrid.Columns></DataGrid>
        </Grid></TabItem>
        <TabItem><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,14">
            <Button Content="选择目录检查重复文件" Style="{StaticResource Primary}" Click="ChooseDuplicates_Click"/>
            <TextBlock Text="最小文件" VerticalAlignment="Center" Margin="4,0,8,0"/>
            <ComboBox x:Name="DuplicateMinimum" SelectedIndex="0" Width="100" VerticalContentAlignment="Center"><ComboBoxItem Content="1 MB" Tag="1048576"/><ComboBoxItem Content="10 MB" Tag="10485760"/><ComboBoxItem Content="100 MB" Tag="104857600"/></ComboBox>
          </WrapPanel>
          <TextBlock x:Name="DuplicateDetail" Grid.Row="1" Text="按大小 → 文件头尾 → 完整 SHA-256 筛选。只读取本地文件，跳过硬链接和云占位文件，不提供自动删除。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
          <DataGrid x:Name="DuplicateGroupsGrid" Grid.Row="2" IsReadOnly="True" SelectionChanged="DuplicateGroup_Changed"><DataGrid.Columns>
            <DataGridTextColumn Header="每份大小" Binding="{Binding SizeText}" Width="100"/><DataGridTextColumn Header="份数" Binding="{Binding Count}" Width="70"/>
            <DataGridTextColumn Header="额外逻辑大小" Binding="{Binding ExtraText}" Width="125"/><DataGridTextColumn Header="示例文件" Binding="{Binding Example}" Width="*"/>
          </DataGrid.Columns></DataGrid>
          <TextBlock Grid.Row="3" Text="选中一组查看路径；双击定位。内容相同也可能被不同程序使用，请自行核对用途。" Foreground="{StaticResource Muted}" Margin="0,14,0,10" TextWrapping="Wrap"/>
          <DataGrid x:Name="DuplicateFilesGrid" Grid.Row="4" IsReadOnly="True" MouseDoubleClick="DuplicateFile_Open"><DataGrid.Columns>
            <DataGridTextColumn Header="同组文件路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/><DataGridTextColumn Header="最后修改" Binding="{Binding ModifiedText}" Width="145"/>
          </DataGrid.Columns></DataGrid>
        </Grid></TabItem>
        <TabItem><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,12">
            <WrapPanel><Button Content="扫描 C/C++ 与显卡缓存" Style="{StaticResource Primary}" Click="Scan_Click"/><Button Content="Windows 系统清理" Click="DiskCleanup_Click"/></WrapPanel>
            <TextBlock Text="应用缓存专项在分类清理页单独勾选：C/C++ 索引和着色器都会重建，首次使用可能变慢。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="扫描 VS 安装临时包" Click="InstallerScan_Click" HorizontalAlignment="Left"/>
            <TextBlock x:Name="InstallerStatus" Text="只识别用户 Temp 下的 VS 包目录特征，不扫描 Windows Installer 或 ProgramData 安装缓存。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
          <DataGrid x:Name="InstallerGrid" Grid.Row="2" SelectionChanged="InstallerRow_Changed"><DataGrid.Columns>
            <DataGridTemplateColumn Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="InstallerCheck_Changed" Unchecked="InstallerCheck_Changed" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="临时目录" Binding="{Binding Root}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="候选大小" Binding="{Binding SizeText}" Width="95" IsReadOnly="True"/><DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="70" IsReadOnly="True"/>
          </DataGrid.Columns></DataGrid>
          <TextBlock Grid.Row="3" Text="文件预览 · 每目录前 200 个；清理处理勾选目录的全部候选。目录特征匹配不等于证明文件无用。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,8"/>
          <DataGrid x:Name="InstallerFiles" Grid.Row="4" IsReadOnly="True" MouseDoubleClick="InstallerFile_Open"><DataGrid.Columns>
            <DataGridTextColumn Header="候选文件 · 双击定位" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/>
          </DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <CheckBox x:Name="InstallerConfirmed" Content="我确认安装已完成、无需保留这些下载包；专项不按保留天数过滤。" Checked="InstallerCheck_Changed" Unchecked="InstallerCheck_Changed" Margin="0,0,0,10"/>
            <Button x:Name="InstallerCleanButton" Content="清理勾选的安装临时包…" IsEnabled="False" Click="InstallerClean_Click" Style="{StaticResource Primary}" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid></TabItem>
      </TabControl>
      <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ProgressBar x:Name="TaskProgress" Height="3" Visibility="Collapsed" IsIndeterminate="True" Foreground="#0A9686" Background="#DBEAE7" BorderThickness="0"/>
        <TextBlock x:Name="StatusText" Grid.Row="1" Text="就绪 · 扫描只读取信息，清理前请检查预览。" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
